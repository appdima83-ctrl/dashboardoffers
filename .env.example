# --- Основное ---
AFFISE_API_KEY=
DASH_PASSWORD=придумайте_пароль
SESSION_SECRET=случайная_строка_64_символа
PORT=3000
# Часовой пояс кабинета Affise, по нему считается «сегодня»
TIMEZONE=Indian/Kerguelen
# Базовый адрес API (по умолчанию https://api-profitcash.affise.com)
AFFISE_BASE=

# --- Ключ Google (один на GA4 и Google Play) ---
# Любой один из трёх способов. На Render удобнее GA_SERVICE_ACCOUNT_JSON: всё содержимое
# JSON-файла сервисного аккаунта одной строкой. Локально — путь к файлу.
GA_SERVICE_ACCOUNT_JSON=
GA_SERVICE_ACCOUNT_FILE=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
# Для отдельного приложения можно задать свой ключ с суффиксом: GA_SERVICE_ACCOUNT_JSON_AXIS и т. п.

# --- GA4 по приложениям ---
# Обычно не нужны: ga.js сам находит свойство по имени Firebase-проекта.
# Заполняйте, только если имя свойства отличается от имени проекта.
GA_PROPERTY_PESOMATCH=
GA_PROPERTY_AXIS=
GA_PROPERTY_KITAPESO=

# --- Google Play ---
# Пакеты приложений: пакет:название через запятую. Пусто = значения из play.js
PLAY_PACKAGES=com.pesomatch.fastloan:PesoMatch fast loan,com.axisfinance.loanguideapp:Axis Finance,com.kitapeso.budgettracker:Kita Peso
# Страна приложения (ISO-2): пакет=PH
PLAY_COUNTRIES=com.pesomatch.fastloan=PH,com.kitapeso.budgettracker=PH
# Ручные пометки статуса (rejected | blocked | review): пакет=статус
PLAY_FLAGS=
# Ручная дата релиза, если новая версия ещё не видна: пакет=ГГГГ-ММ-ДД
PLAY_RELEASED=
# Скрыть дорожку вручную (пауза теста не видна в API): пакет=дорожка
PLAY_HIDE=
# Старт закрытого теста: пакет=ГГГГ-ММ-ДД или пакет=wait
PLAY_TEST_START=

# --- Витрина ---
# Скрытые офферы (названия или ID через запятую; пусто = показывать все)
HIDE_OFFERS=
# Вкладка «По приложениям»: метка sub1 → пакет в Google Play (иконка и название из Play)
SRC_APPS=pesomatch=com.pesomatch.fastloan,axis=com.axisfinance.loanguideapp,kitapeso=com.kitapeso.budgettracker
# Метка sub1 → Название|ISO2|ID свойства GA4 — для приложений, которых нет в Google Play
SRC_META=pesomatch=PesoMatch fast loan|PH|,axis=Axis Finance||,kitapeso=Kita Peso|PH|

# --- Отладка ---
# GA_MOCK=1 — отдавать выдуманные данные аналитики вместо запросов в Google
GA_MOCK=

AFFISE_API_KEY=
DASH_PASSWORD=придумайте_пароль
SESSION_SECRET=случайная_строка_64_символа
PORT=3000
GA_PROPERTY_WONGA=546879836
GA_SERVICE_ACCOUNT_FILE=
GA_SERVICE_ACCOUNT_JSON=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# Mpowa (Firebase-проект in-emergency-loan-guide): ID свойства GA4 и, если нужен другой сервисный аккаунт, отдельные ключи с суффиксом _MPOWA
GA_PROPERTY_MPOWA=

# Google Play: пакеты приложений через запятую в виде пакет:название
PLAY_PACKAGES=com.wonga.otpusk_planner:Wonga,com.wonga.loanpointer:Wonga Loan Pointer,com.prestomin.guia:Prestomin,com.navo.navo_calculator:Navo Calculator,com.mepresta.dinerorapidocalc:Mepresta Calc,com.prestomin.dinerorapido:Prestomin Dinero Rápido,com.unifi.financecalc:Unifi finance - calc app,com.kwikloanguide.app:Kwik - Personal Loan Guide app,com.emergencyloanguide.app:Mpowa finance - loan guid app,com.naviosgaming.app:Navios - Gaming Betting Guide
# Ручные пометки статуса (rejected | blocked | review), через запятую: пакет=статус
PLAY_FLAGS=com.naviosgaming.app=rejected
# Ручная дата последнего релиза (если новая версия на проверке и ещё не видна): пакет=ГГГГ-ММ-ДД
PLAY_RELEASED=com.unifi.financecalc=2026-10-20,com.kwikloanguide.app=2026-10-21,com.wonga.loanpointer=2026-10-20,com.prestomin.dinerorapido=2026-10-15,com.prestomin.guia=2026-10-21
# Скрыть дорожки вручную (пауза теста не видна в API): пакет=дорожка (alpha = «Закрытое тестирование»)
PLAY_HIDE=com.prestomin.guia=alpha
# Старт закрытого теста (14 дней с даты проверки, из консоли «Подача заявки на доступ к рабочей версии»): пакет=ГГГГ-ММ-ДД
PLAY_TEST_START=com.wonga.loanpointer=2026-10-17
